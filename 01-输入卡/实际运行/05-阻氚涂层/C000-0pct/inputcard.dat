! Basic card 1: MSRE single-fluid Briggs-54 baseline.
&reactor_geo
  Reactor_Type      = 'MSRE'
  Geometry_Type     = 'MSRE_EDGE'
  Fuel_Salt_Kind    = 'MSRE_U235'
  Blanket_Salt_Kind = 'NONE'
  Secondary_Salt_Kind = 'MSRE_COOLANT'
  Topology_File      = 'msre-briggs70p5-v1.topo'
  Core_Height_m   = 1.57798d0
  R_Core_m        = 0.70485d0
  A_Core_Flow_m2  = 0.344734407280194d0
  HX_Surface_Area_m2      = 24.06188736d0
  HX_OD_m                 = 0.0127d0
  HX_Wall_Thick_m         = 0.001067d0
  Pipe_Wall_Thick_m       = 0.0065d0
  N_HX_Tubes              = 159
  ! 44 ft3 is reference only; approximately 23 L auxiliary salt is NOT modeled.
  MSRE_Sec_Total_Salt_Vol_m3     = 1.245941250048d0
  MSRE_Sec_Explicit_Pipes       = .true.
  ! Estimated lengths from ORNL-TM-728 Table 5.12; flow order 200/201/202.
  MSRE_Sec_Pipe_Length_m        = 21.3661625d0, 23.301325d0, 12.7d0
  MSRE_Sec_Pipe_Nodes           = 10, 10, 6
  MSRE_Sec_PHX_Header_Vol_m3    = 0.022640669785746d0, 0.022640669785746d0
  MSRE_Sec_Rad_Header_Vol_m3    = 0.028590923587711d0, 0.028590923587711d0
  MSRE_Sec_PHX_N_Tubes           = 159
  MSRE_Sec_PHX_Surface_Area_m2   = 24.06188736d0
  MSRE_Sec_PHX_Tube_OD_m         = 0.0127d0
  MSRE_Sec_PHX_Tube_Wall_Thick_m = 0.001067d0
  MSRE_Sec_PHX_Tube_Vol_m3       = 0.059490992818908d0
  MSRE_Sec_Rad_N_Tubes           = 120
  ! Reference OUTER heat-transfer area only; wall areas use tube dimensions.
  MSRE_Sec_Rad_Surface_Area_m2   = 65.58954624d0
  MSRE_Sec_Rad_Tube_OD_m         = 0.01905d0
  MSRE_Sec_Rad_Tube_Wall_Thick_m = 0.0018288d0
  MSRE_Sec_Rad_Tube_Len_m        = 9.144d0
  MSRE_Sec_Rad_Vol_m3            = 0.204183209634d0
  MSRE_Sec_Bowl_Liq_m3           = 0.1160990710272d0
  MSRE_Sec_Bowl_Gas_m3 = 0.0d0
  MSRE_Sec_Pipe_ID_m             = 0.1282d0
  MSRE_Sec_Pipe_Leak_Thick_m     = 0.0065532d0
  D_Hydraulic_m   = 0.01524d0
  HX_Shell_Dh_m   = 0.0209d0
  Rho_Graphite    = 1860.0d0
  ! A50_MTF0p50_600D: graphite capacity sweep.
  Graph_Cap_A_MSRE      = 9.500000000000d-05
  Graph_Cap_B_MSRE      = 19000.0d0
  HL_Len_m        = 1.83d0
  HL_ID_m         = 0.1282d0
  PP_Len_m        = 1.07d0
  PP_ID_m         = 0.1282d0
  HX_Len_m        = 2.44d0
  HX_Flow_A_m2    = 0.0412d0
  HX_Vol_m3       = 0.45d0
  CL_Len_m        = 1.68d0
  CL_ID_m         = 0.1282d0
  DC_Height_m     = 1.626d0
  DC_ID_m         = 1.4224d0
  DC_OD_m         = 1.4732d0
  DC_Len_Factor   = 1.5d0
  V_LP_m3         = 0.108d0
  V_UP_m3         = 0.297d0
  Vol_Bowl_Liq_m3 = 0.116d0
  Vol_Bowl_Gas_m3 = 0.071d0
  T_Bowl_Fuel_C   = 650.0d0
  T_Bowl_Blanket_C = 650.0d0
  Vessel_Area     = 10.0d0
  Vessel_Thick    = 0.015d0
  Pipe_Area       = 4.6d0
  Pipe_Thick      = 0.0066d0
  HX_Shell_Area   = 3.2d0
  HX_Shell_Thick  = 0.013d0
  PRF_HX_Tube     = 1.0000000000000d0
  PRF_HX_Shell    = 20.0d0
  PRF_Radiator    = 20.0d0
  PRF_Pipe        = 20.0d0
  PRF_Vessel      = 20.0d0
  Area_Metal_DC   = 17.7d0
  Area_Metal_LP   = 11.0d0
  Area_Metal_Core = 7.7d0
  Area_Metal_UP   = 9.0d0
  Sh_Plenum       = 300.0d0
/
&operate
  ! V17 downstream reference model; TF remains explicitly LEGACY_ENGINEERING_ASSUMPTION.
  Offgas_5A_Temperature_K = 303.15d0
  Offgas_5A_Cells = 160
  Offgas_Oxidizer_Rate_Basis = 'ACTUAL'
  Offgas_Downstream_Model = 'LEGACY'
  Offgas_TF_Equil_B_K = 6289.0d0
  Offgas_TF_Equil_A = 7.0d0
  ! Original engineering assumption restored by user request; no experimental fit.
  Offgas_Oxidizer_Pressure_Pa = 101325.0d0
  Offgas_Oxidizer_Temperature_K = 473.15d0
  Offgas_TF_Bed_Pressure_Pa = 101325.0d0
  Offgas_Gas_Flow_Basis = 'TOTAL'
  MSRE_Sec_Pump_CoverGas_m3_s = 6.0d-5
  MSRE_Sec_Pump_Contact_Eff = 0.1d0
  offgas_hto_bed_breakthrough_end_frac = 1.0d0
  offgas_hto_bed_breakthrough_start_frac = 0.90d0
  offgas_hto_bed_clean_eff = 0d0
  offgas_hto_bed_utilization_factor = 0d0
  offgas_hto_bed_water_capacity_wt = 0d0
  offgas_hto_bed_mass_kg = 1.0d0
  offgas_hto_bed_water_capacity_mol = 0.0d0
  offgas_hto_bed_residence_time_s = 0.0d0
  offgas_hto_bed_rate_s = 0.0d0
  offgas_o2_excess_factor = 10.0d0
  offgas_oxidizer_bed_volume_m3 = 1.51d-3
  offgas_oxidizer_catalyst_k_s = 3.198034851380619d0
  offgas_oxidizer_residence_time_s = 0.0d0
  offgas_oxidizer_rate_s = 0.0d0
  offgas_tf_to_hto_fraction = 0.0d0
  offgas_tf_hf_masstransfer_factor = 0.95d0
  offgas_tf_bed_breakthrough_end_frac = 1.0d0
  offgas_tf_bed_breakthrough_start_frac = 0.90d0
  offgas_tf_bed_temperature_k = 423.15d0
  offgas_tf_bed_residence_time_s = 2.0d0
  offgas_tf_bed_rate_s = 3.6d0
  offgas_tf_bed_capacity_ci = 4.0d5
  offgas_h2o_mole_fraction = 1.0d-4
  offgas_gas_pressure_pa = 101325.0d0
  offgas_gas_temperature_k = 908.15d0
  offgas_gas_flow_m3_s = 1.8d-4
  Enable_Secondary_Loop     = .true.
  Enable_Thermal_MCPDT      = .true.
  Power_MW            = 7.25d0
  Flow_GPM            = 1200.0d0
  T_inlet_C           = 635.0d0
  T_initial_C         = 635.0d0
  Li6_ppm             = 4.800000320215d+01
  Redox_Mode          = 'FLOATING'
  Redox_Ratio_U       = 100.0d0
  Pump_Efficiency     = 1.0d0
  Gas_Purge_cm3_s     = 180.0d0
  Salt_Bubble_Frac    = 0.005d0
  Pump_Stripping_Model = 'BRIGGS_EFFECTIVE'
  Pump_Briggs_kA_T2    = 0.02d0
  Pump_Briggs_kA_TF    = 0.70d0
  Q_Spray_GPM         = 74.5d0
  MSRE_T2_kDim_Fuel        = 0.02d0
  MSRE_T2_kDim_Coolant     = 0.02d0
  Offgas_Treatment_Model = 'PASS_THROUGH'
  offgas_param_set = 'USER'
  offgas_t2_polisher_model = 'NONE'
  offgas_delay_tau_s = 5400.0d0
  offgas_bypass_fraction = 1.0d-3
  offgas_tf_bed_eff = 0.0d0
  offgas_t2_separator_eff = 0.0d0
  offgas_t2_oxidizer_eff = 0.0d0
  offgas_hto_trap_eff = 0.0d0
  offgas_t2_getter_eff = 0.0d0
  Initial_Cr_ppm      = 25.0d0
  Mole_Frac_UF4       = 0.009d0
  T_Sec_Inlet_C       = 551.666666667d0
  T_Sec_Outlet_C      = 593.333333333d0
  MSRE_Sec_Flow_m3_s          = 5.362666694d-2
  MSRE_Sec_Pump_Purge_m3_s    = 1.0d-5
  MSRE_Sec_Pump_Offgas_m3_s   = 2.333333333333d-5
  MSRE_Sec_Fountain_Flow_m3_s = 9.5d-4
/
&calculate
  Enable_Checkpoint_Output = .true.
  Restart_Write_Interval_Steps = 144000
  Mass_Transfer_Factor        = 0.50d0
  ! Briggs Case 27 is a prescribed transport-source benchmark, not an
  ! independent neutron cross-section calculation.
  Tritium_Source_Model       = 'DIRECT_RATE'
  Source_Total_Ci_Day        = 54.0d0
  Source_Li6_Ci_Day          = 0.0d0
  Source_Li7_Ci_Day          = 54.0d0
  Source_Other_Ci_Day        = 0.0d0
  Graphite_MTC_MSRE            = 'RECT_GROOVE_ENTRY_GRAETZ'
  Metal_Permeation_Model      = 'CALIBRATED_LAYER_RESISTANCE'
  Tritium_Barrier_Profile     = 'LIANG_2023_AL2O3_NIAL'
  Coat_HX_Tube                = .true.
  Coat_HX_Shell               = .true.
  Coat_Radiator               = .true.
  Coat_Pipe                   = .true.
  Coat_Vessel                 = .true.
  Tritium_Barrier_Coverage    = 0.0000000000d0
  Environment_T2_Partial_Pressure_Pa = 0.0d0
  Enable_Restart              = .true.
  Time_Method     = 'EXPLICIT'
  Slow_Step_s     = 0.60d0
  dt_step         = 0.15d0
  Total_Steps     = 345600000
  Nz_nodes        = 20
  Nr_nodes        = 20
  N_Channels      = 1140
  N_HL_Nodes      = 1
  N_PP_Nodes      = 1
  N_HX_Nodes      = 20
  N_HX_Rad_Nodes  = 20
  N_Metal_Rad_Nodes = 20
  N_CL_Nodes      = 1
  Secondary_Nodes = 5
/
